{
  "name": "@mi/sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outdir=dist --external:express --external:@google-cloud/firestore --external:resend --external:stripe",
    "start": "node dist/index.js",
    "deploy": "gcloud run deploy sentinel --source . --region us-central1 --allow-unauthenticated",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.0.0",
    "express": "^4.18.0",
    "resend": "^4.0.0",
    "stripe": "^17.0.0",
    "zod": "^3.24.1",
    "@mi/contracts": "workspace:*",
    "@mi/research": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
