# Root Monorepo Environment Variables Template
# Copy to apps/web/.env and apps/desktop/.env as needed

# Firebase Configuration (project: geminixprize-504607)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=geminixprize-504607.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=geminixprize-504607
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google OAuth Credentials for Electron Desktop App
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gemini API Key (for Live Gemini Research Engine)
GEMINI_API_KEY=your-gemini-api-key
